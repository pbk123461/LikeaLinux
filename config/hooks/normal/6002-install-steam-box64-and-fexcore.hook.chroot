#!/bin/sh
# .hook.chroot script for live-build
# Installs Native ARM64 Steam, Hangover Wine, ProtonGE, and Snapdragon drivers
# Target: Debian-based ARM64 ISO-Hybrid

set -e

# Export non-interactive environment to prevent apt from stalling
export DEBIAN_FRONTEND=noninteractive

echo "=============================================="
echo " Step 1: Adding Repositories & Updating System"
echo "=============================================="
# Add armhf architecture for Box86 and 32-bit ARM compatibility
dpkg --add-architecture armhf
apt-get update

echo "=============================================="
echo " Step 2: Installing Snapdragon/ARM Laptop Drivers"
echo "=============================================="
# Install comprehensive firmware and drivers for ARM/Snapdragon devices
apt-get install -y --no-install-recommends \
    linux-firmware \
    firmware-misc-nonfree \
    firmware-atheros \
    firmware-realtek \
    firmware-qcom-soc \
    wireless-regdb \
    bluez-firmware \
    mesa-vulkan-drivers \
    mesa-va-drivers \
    libgl1-mesa-dri \
    xserver-xorg-video-all \
    xserver-xorg-video-fbdev \
    pulseaudio \
    pipewire \
    pipewire-pulse \
    dbus-x11 \
    wget \
    ca-certificates \
    tar \
    xz-utils

echo "=============================================="
echo " Step 3: Installing Box86/Box64 (Hangover Dependencies)"
echo "=============================================="
# Hangover relies on Box86/Box64 to translate x86/x64 instructions on ARM.
# Downloading pre-compiled binaries to save compile time in the ISO build.
cd /tmp

# Box86 (for x86 32-bit)
wget -q "https://github.com/ptitSeb/box86/releases/download/v0.3.2/box86-generic-ROOT_ARM64.tar.gz" -O box86.tar.gz
tar -xzf box86.tar.gz -C /
rm -f box86.tar.gz

# Box64 (for x86_64 64-bit)
wget -q "https://github.com/ptitSeb/box64/releases/download/v0.2.8/box64-generic-ROOT_ARM64.tar.gz" -O box64.tar.gz
tar -xzf box64.tar.gz -C /
rm -f box64.tar.gz

echo "=============================================="
echo " Step 4: Installing Native ARM64 Steam Client"
echo "=============================================="
# Based on the Interfacing Linux community guide for Native Steam.
# Downloading the community-ported native ARM64 .deb package.
STEAM_DEB_URL="https://interfacinglinux.com/community/sbcsoftware/native-steam-client-for-arm-linux/steam-launcher_arm64.deb"
wget -q "$STEAM_DEB_URL" -O /tmp/steam-launcher_arm64.deb

# Install Steam, automatically resolving missing dependencies
apt-get install -y /tmp/steam-launcher_arm64.deb || apt-get install -f -y
rm -f /tmp/steam-launcher_arm64.deb

echo "=============================================="
echo " Step 5: Installing Hangover Wine & Hangover-ProtonGE"
echo "=============================================="
# Pre-configuring directories for the default live user (UID 1000)
LIVE_USER_HOME="/home/user"
mkdir -p "$LIVE_USER_HOME/.steam/root/compatibilitytools.d/"
mkdir -p "$LIVE_USER_HOME/.local/share/Steam/compatibilitytools.d/"

# 1. Install Hangover Wine (Debian package)
# Note: Update URL to the latest release from the Hangover GitHub repository
wget https://github.com/AndreRH/hangover/releases/download/hangover-11.9/hangover_11.9_debian13_trixie_arm64.tar

tar -xvf hangover_11.9_debian13_trixie_arm64.tar

apt-get update

DEBIAN_FRONTEND=noninteractive 
apt-get purge -y fonts-wine wine || true

DEBIAN_FRONTEND=noninteractive 
apt-get install -y -o Dpkg::Options::="--force-overwrite" ./hangover*.deb

rm -f hangover_11.9_debian13_trixie_arm64.tar
rm -f hangover*.deb
rm -f dxvk*.tar.gz

apt-get clean
# 2. Install Hangover-ProtonGE (Extracted to Steam compatibilitytools.d)
# Note: Update URL to the latest release from the Hangover-ProtonGE repository
HANGOVER_PROTONGE_URL="https://github.com/scaronni/Hangover-ProtonGE/releases/download/v0.1.0/Hangover-ProtonGE-0.1.0.tar.xz"
wget -q "$HANGOVER_PROTONGE_URL" -O /tmp/hangover-protonge.tar.xz

# Extract to both standard Steam and Flatpak Steam directories just in case
tar -xJf /tmp/hangover-protonge.tar.xz -C "$LIVE_USER_HOME/.steam/root/compatibilitytools.d/"
tar -xJf /tmp/hangover-protonge.tar.xz -C "$LIVE_USER_HOME/.local/share/Steam/compatibilitytools.d/"
rm -f /tmp/hangover-protonge.tar.xz

echo "=============================================="
echo " Step 6: Configuring Live Environment"
echo "=============================================="
# Ensure the live user owns the installed compatibility tools and configs
chown -R 1000:1000 "$LIVE_USER_HOME"

# Create a Desktop Shortcut for easy launching from the Live ISO
mkdir -p "$LIVE_USER_HOME/Desktop"
cat << 'EOF' > "$LIVE_USER_HOME/Desktop/steam.desktop"
[Desktop Entry]
Name=Steam (ARM Native)
Comment=Run Steam for ARM64
Exec=/usr/bin/steam
Icon=steam
Terminal=false
Type=Application
Categories=Game;
EOF
chmod +x "$LIVE_USER_HOME/Desktop/steam.desktop"
chown 1000:1000 "$LIVE_USER_HOME/Desktop/steam.desktop"

# Clean up apt cache to reduce ISO size
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "ARM64 Steam, Hangover, and Snapdragon drivers setup complete!"