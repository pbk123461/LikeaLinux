#!/bin/bash
set -e

# .hook.chroot script to install Steam for arm64 on a Debian live ISO
# Includes Hangoverwine and Hangover-ProtonGE

echo "=== Starting Steam for arm64 installation ==="

# Update package list
apt-get update -qq

# Enable multiarch for arm64 (if not already)
if ! dpkg --print-foreign-architectures | grep -q arm64; then
    dpkg --add-architecture arm64
    apt-get update -qq
fi

# Install Steam and dependencies
echo "Installing Steam and dependencies..."
apt-get install -y --no-install-recommends \
    steam \
    steam-devices \
    libgl1 \
    libgl1:arm64 \
    libglx0 \
    libglx0:arm64 \
    libvulkan1 \
    libvulkan1:arm64 \
    mesa-vulkan-drivers \
    mesa-vulkan-drivers:arm64 \
    libdrm2 \
    libdrm2:arm64 \
    libwayland-client0 \
    libwayland-client0:arm64 \
    libwayland-server0 \
    libwayland-server0:arm64 \
    libinput-bin \
    libinput10 \
    libinput10:arm64 \
    libudev1 \
    libudev1:arm64 \
    libdbus-1-3 \
    libdbus-1-3:arm64 \
    libgbm1 \
    libgbm1:arm64 \
    libegl1 \
    libegl1:arm64 \
    libglvnd0 \
    libglvnd0:arm64 \
    xauth \
    xauth \
    xvfb \
    xvfb \
    wget \
    ca-certificates \
    gnupg \
    --no-install-recommends

# Install wine and dependencies for Hangoverwine
echo "Installing Wine and dependencies..."
apt-get install -y --no-install-recommends \
    wine \
    wine32 \
    wine64 \
    libwine \
    libwine:i386 \
    fonts-wine \
    winetricks \
    --no-install-recommends

# Install Hangoverwine (from Hangover project)
echo "Installing Hangoverwine..."
HANGOVER_DIR="/opt/hangover"
mkdir -p "${HANGOVER_DIR}"
cd "${HANGOVER_DIR}"
if [ ! -d "hangover-wine" ]; then
    git clone https://github.com/HangoverProject/hangover-wine.git hangover-wine
fi
echo "Hangoverwine source cloned to ${HANGOVER_DIR}/hangover-wine"

# Install Hangover-ProtonGE (Proton GE fork for Hangover)
echo "Installing Hangover-ProtonGE..."
PROTON_DIR="/opt/hangover-protonge"
mkdir -p "${PROTON_DIR}"
cd "${PROTON_DIR}"
if [ ! -d "ProtonGE" ]; then
    git clone https://github.com/GloriousEggroll/Proton-GE.git ProtonGE
fi
echo "Hangover-ProtonGE source cloned to ${PROTON_DIR}/ProtonGE"

# Create a wrapper script to run Steam with Hangoverwine/ProtonGE (optional)
cat > /usr/local/bin/steam-hangover << 'INNER_EOF'
#!/bin/bash
# Wrapper to launch Steam with Hangoverwine and ProtonGE
export HANGOVER_PATH="/opt/hangover/hangover-wine"
export PROTON_PATH="/opt/hangover-protonge/ProtonGE"
export STEAM_COMPAT_DATA_PATH="${HOME}/.steam/steam/steamapps/compatdata"
export STEAM_COMPAT_TOOL_PATH="${PROTON_PATH}"
export STEAM_COMPAT_TOOL_VERSION_ENABLE=1
export STEAM_COMPAT_TOOL="ProtonGE"
export WINEDLLOVERRIDES="winemenubuilder.exe=d"
export WINEPREFIX="${HOME}/.steam/steam/steamapps/compatdata/${STEAM_COMPAT_TOOL_VERSION:-latest}/pfx"
export WINEESYNC=1
export WINEFSYNC=1
exec steam "$@"
INNER_EOF
chmod +x /usr/local/bin/steam-hangover

# Create desktop entries for Steam and steam-hangover
DESKTOP_DIR="/usr/share/applications"
mkdir -p "${DESKTOP_DIR}"

# Steam desktop entry
cat > "${DESKTOP_DIR}/steam.desktop" << 'INNER_DESKTOP'
[Desktop Entry]
Name=Steam
Comment=Plataforma de distribución de videojuegos
Exec=steam %U
Icon=steam
Terminal=false
Type=Application
Categories=Game;Application;
INNER_DESKTOP

# Steam with Hangoverwine/ProtonGE desktop entry
cat > "${DESKTOP_DIR}/steam-hangover.desktop" << 'INNER_DESKTOP2'
[Desktop Entry]
Name=Steam (HangoverWine + ProtonGE)
Comment=Ejecutar Steam con HangoverWine y Proton-GE para juegos de Windows en ARM64
Exec=steam-hangover %U
Icon=steam
Terminal=false
Type=Application
Categories=Game;Application;
INNER_DESKTOP2

# Clean up
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "=== Steam for arm64 with Hangoverwine and Hangover-ProtonGE installed ==="
echo "You can launch Steam with Hangoverwine/ProtonGE using: steam-hangover"
echo "Or run regular steam with: steam"
echo "Desktop entries created in ${DESKTOP_DIR}"
