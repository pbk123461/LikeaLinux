#!/bin/sh

set -e

export ZSH=/etc/skel/.oh-my-zsh
export HOME=/etc/skel

INSTALL_SCRIPT="$(mktemp)"
wget -q https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh -O "${INSTALL_SCRIPT}"
sh "${INSTALL_SCRIPT}" "" --unattended
rm -f "${INSTALL_SCRIPT}"

if [ -f /etc/skel/.oh-my-zsh/templates/zshrc.zsh-template ]; then
    cp /etc/skel/.oh-my-zsh/templates/zshrc.zsh-template /etc/skel/.zshrc
fi

chsh $(which zsh) || true
